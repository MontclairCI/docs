{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Montclair CI",
  "colors": {
    "primary": "#370a00",
    "dark": "#8c3f27",
    "light": "#feecd3"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo_dark.svg"
  },
  "banner": {
    "content": "Montclair CI is free for public repositories. [Learn more about allowances](/how-it-works/allowances)"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#fff",
      "dark": "#000"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          "index",
          {
            "group": "TUTORIALS",
            "icon": "book-open",
            "pages": [
              "tutorials/github",
              "tutorials/gitlab",
              "tutorials/gitea",
              "tutorials/forgejo"
            ]
          },
          {
            "group": "HOW IT WORKS",
            "icon": "shapes",
            "pages": [
              "how-it-works/overview",
              "how-it-works/pipelines",
              "how-it-works/images",
              "how-it-works/rules",
              "how-it-works/jobs",
              "how-it-works/ssh-tunnel",
              "how-it-works/allowances",
              "how-it-works/managed-runners",
              "how-it-works/self-hosted-runners"
            ]
          },
          {
            "group": "EXAMPLES",
            "icon": "box",
            "pages": [
              "examples/hello-world",
              "examples/rules",
              "examples/jobs",
              "examples/managed-runners",
              "examples/self-hosted-runners"
            ]
          },
          {
            "group": "API Reference",
            "icon": "code",
            "pages": [
              "api-reference/pipeline-configuration-language",
              "api-reference/cli",
              "api-reference/http-json"
            ]
          }
        ]
      },
      {
        "tab": "Blog",
        "pages": [
          "blog"
        ]
      },
      {
        "tab": "Pricing",
        "pages": [
          "pricing"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo_dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://ci.montclairci.com"
    },
    "links": [
      {
        "label": "Support",
        "href": "/support"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/MontclairCI/feedback/issues/new",
      "discord": "https://discord.gg/6VY5xRXV2"
    },
    "links": [
      {
        "header": "Links",
        "items": [
          {
            "label": "Terms of Use",
            "href": "/terms-of-use"
          },
          {
            "label": "Privacy Policy",
            "href": "/privacy-policy"
          }
        ]
      }
    ]
  },
  "description": "FreeBSD and Linux CI runners",
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "errors": {
    "404": {
      "redirect": false,
      "description": "The URL that you were looking for does not exist. Please check your URL or [go back to home](https://montclairci.com/)"
    }
  },
  "icons": {
    "library": "lucide"
  }
}
