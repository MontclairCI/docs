{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Montclair CI",
  "description": "Build more, often",
  "theme": "aspen",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#370a00",
    "dark": "#8c3f27",
    "light": "#feecd3"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo_dark.svg"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#fff",
      "dark": "#000"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "align": "start",
        "pages": [
          "index",
          {
            "group": "Tutorials",
            "icon": "book-open",
            "pages": [
              "tutorials/github",
              "tutorials/gitlab",
              "tutorials/gitea",
              "tutorials/forgejo"
            ]
          },
          {
            "group": "How it works",
            "icon": "shapes",
            "pages": [
              "how-it-works/overview",
              "how-it-works/pipelines",
              "how-it-works/images",
              "how-it-works/rules",
              "how-it-works/jobs",
              "how-it-works/ssh-tunnel",
              "how-it-works/allowances",
              "how-it-works/managed-runners",
              "how-it-works/self-hosted-runners"
            ]
          },
          {
            "group": "Examples",
            "icon": "box",
            "pages": [
              "examples/rules",
              "examples/jobs",
              "examples/managed-runners",
              "examples/self-hosted-runners"
            ]
          },
          {
            "group": "API Reference",
            "icon": "code",
            "pages": [
              "api-reference/pipeline-configuration-language",
              "api-reference/cli",
              "api-reference/http-json"
            ]
          }
        ]
      },
      {
        "tab": "Blog",
        "align": "start",
        "pages": [
          "blog"
        ]
      },
      {
        "tab": "Pricing",
        "align": "start",
        "pages": [
          "pricing"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_light.svg",
    "dark": "/images/logo_dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://ci.montclairci.com"
    },
    "links": [
      {
        "label": "Support",
        "href": "/support"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/MontclairCI/feedback/issues/new",
      "discord": "https://discord.gg/TKubPvu4ZM",
      "bluesky": "https://bsky.app/profile/montclairci.bsky.social"
    },
    "links": [
      {
        "items": [
          {
            "label": "Terms of Use",
            "href": "/terms-of-use"
          },
          {
            "label": "Privacy Policy",
            "href": "/privacy-policy"
          },
          {
            "label": "Security Disclosure",
            "href": "/security-disclosure"
          }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "description": "The URL that you were looking for does not exist. Please check your URL or [go back to home](/)"
    }
  },
  "banner": {
    "content": "Working on open source software? Apply to the [Montclair For Maintainers program](/for-maintainers) for **free compute credits**."
  }
}
